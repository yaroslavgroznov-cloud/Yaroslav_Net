---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import LetterPage from "../../components/LetterPage.astro";
import Footer from "../../components/Footer.astro";
import t from "../../i18n/ru.json";

const locale = "ru" as const;
const pageTitle = `${t.letter.title} · ${t.meta.title}`;
const pageDescription = t.letter.lede;
---

<BaseLayout
  locale={locale}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  path="/letter"
>
  <Header locale={locale} t={t} path="/letter" />
  <LetterPage t={t} locale={locale} />
  <Footer t={t} />
</BaseLayout>
