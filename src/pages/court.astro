---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import CourtPage from "../components/CourtPage.astro";
import Footer from "../components/Footer.astro";
import t from "../i18n/en.json";

const locale = "en" as const;
const pageTitle = `${t.court_page.title_short} · ${t.meta.title}`;
const pageDescription = t.court_page.description;
---

<BaseLayout
  locale={locale}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  path="/court"
>
  <Header locale={locale} t={t} path="/court" />
  <CourtPage t={t} locale={locale} />
  <Footer t={t} />
</BaseLayout>
